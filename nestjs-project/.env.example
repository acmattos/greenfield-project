# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object Storage (MinIO — upload-processing/TD-01, TD-02)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=videos
STORAGE_ACCESS_KEY_ID=streamtube
STORAGE_SECRET_ACCESS_KEY=streamtube
STORAGE_PRESIGNED_URL_TTL_SECONDS=3600

# Background Job Queue (Redis/BullMQ — upload-processing/TD-03)
REDIS_HOST=redis
REDIS_PORT=6379

# Vendored FFmpeg/FFprobe (worker image only — upload-processing/TD-04)
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# tus resumable upload protocol (upload-processing/TD-05)
MAX_UPLOAD_BYTES=10737418240

# Worker: concurrency + /tmp free-space preflight (upload-processing/TD-07)
WORKER_CONCURRENCY=1
WORKER_TEMP_MARGIN_BYTES=536870912
WORKER_ORPHAN_SWEEP_THRESHOLD_MS=3600000
